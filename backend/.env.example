NODE_ENV=development
PORT=5000

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/stockflow"

# JWT Secrets (change these in production — min 32 chars)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-min-32-chars

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000

# ✅ Google Gemini API (FREE)
# Get your key at: https://aistudio.google.com → "Get API Key"
# Free tier: 15 req/min, 1 million tokens/day — no credit card needed
GEMINI_API_KEY=your-gemini-api-key-here

# Email / SMTP (optional — for password reset & low-stock alerts)
# Gmail: enable 2FA, then create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# Cloudinary (optional — for cloud image uploads)
# Free tier available at cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
